# Fuente de datos de la app web.
#   mock     → escenario ficticio generado en memoria (no necesita base de datos)
#   supabase → Supabase local o remoto con las migraciones de /supabase
DATA_SOURCE=mock

# Supabase (solo con DATA_SOURCE=supabase). Valores locales: `pnpm db:start` los imprime.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para scripts de servidor (seed). Nunca exponer al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Rol simulado en modo mock: publico | operador | fiscalia
DEMO_ROLE=operador
